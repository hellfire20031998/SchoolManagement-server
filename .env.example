# Copy to `.env` in this folder (only `.env` is loaded). Do not commit `.env`.
#
# Atlas: Database → Connect → Drivers → Node.js → copy the connection string.
# Replace <password> with your DB user password (URL-encode special chars).
# Add a database name before the query, e.g. ...mongodb.net/school_management?retryWrites=true&w=majority
# Network Access must allow your IP (or 0.0.0.0/0 for testing).

PORT=5000
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER_SUBDOMAIN.mongodb.net/school_management?retryWrites=true&w=majority&appName=SchoolApp
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
